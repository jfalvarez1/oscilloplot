// Generated from oscilloplot.rc.in by CMake - do not edit the .rc directly.
#include <winres.h>

// Exe icon (Explorer, taskbar). ID 1 = first icon group; the code in
// app.cpp loads the same group for the window via MAKEINTRESOURCE(1).
1 ICON "@OSCILLOPLOT_ICO_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Oscilloplot - XY Audio Generator"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "oscilloplot"
            VALUE "OriginalFilename", "oscilloplot.exe"
            VALUE "ProductName", "Oscilloplot"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
